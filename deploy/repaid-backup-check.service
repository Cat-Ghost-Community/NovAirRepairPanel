[Unit]
Description=Repaid authenticated database and attachment recovery check
After=network-online.target

[Service]
Type=oneshot
User=repaid
Group=repaid
WorkingDirectory=/opt/repaid
Environment=NODE_ENV=production
Environment=REPAID_DEMO_MODE=0
Environment=REPAID_BACKUP_DIR=/var/backups/repaid
Environment=REPAID_BACKUP_WORK_DIR=/var/lib/repaid/backup-work
Environment=REPAID_BACKUP_MAX_AGE_SECONDS=7200
EnvironmentFile=/etc/repaid/backup.env
ExecStart=/usr/bin/npm run backup:check
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/repaid
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
