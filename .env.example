# ── تنظیمات اجرای «تعمیرکار» روی سرور ─────────────────────────────────────────
# این فایل نمونهٔ سرور لینوکس است؛ مقادیر واقعی را در فایل محیط خصوصی سرویس قرار دهید.
# ویزارد نصب، فایل محیط و مسیرهای پایدار را برای سرور ایجاد می‌کند.

# نیازمندی تأییدشده: Node.js نسخهٔ ۲۴ (به دلیل node:sqlite)

# Server port; HOSTNAME is used by standalone/container startup.
# For next start, explicitly pass --hostname 127.0.0.1 (see DEPLOYMENT.md).
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
WEB_CONCURRENCY=1
# SQLite: one web process, durable local disk. No serverless or shared-network disk.
TZ=Asia/Tehran

# Canonical HTTPS origin behind the reverse proxy (required for production CSRF checks).
APP_ORIGIN=https://repaid.example.com
# Set to 1 ONLY with a private app listener behind a trusted proxy that overwrites
# X-Real-IP (the supplied nginx config does). Default: no trusted signature IP.
REPAID_TRUST_PROXY=0
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# REPAID_ENCRYPTION_KEY=
# Extra HTTPS hostnames permitted for custom SMS/postal services, comma separated.
REPAID_OUTBOUND_HOSTS=
# Additional browser connections or payment form destinations require reviewed,
# exact HTTPS origins (comma separated; no wildcards, paths or credentials).
# Server SMS/postal hosts remain governed separately by REPAID_OUTBOUND_HOSTS.
REPAID_BROWSER_CONNECT_ORIGINS=
REPAID_BROWSER_FORM_ORIGINS=
# Do not contact international framework telemetry endpoints during builds/startup.
NEXT_TELEMETRY_DISABLED=1
# Defense in depth: synthetic fixtures are test-only and never loaded by the website.
REPAID_DEMO_MODE=0
# Bootstrap secrets: supply only for npm run setup; remove afterwards.
# REPAID_OWNER_EMAIL=
# REPAID_OWNER_PASSWORD=

# محل نگهداری دیتابیس SQLite (فایل repaid.db و فایل‌های WAL کنارش)
# روی سرور مسیری پایدار و پشتیبان‌گیری‌شدنی بدهید؛ برای داکر داخل volume بگذارید.
# خالی بگذارید تا در ./data کنار برنامه ساخته شود.
REPAID_DATA_DIR=

# Live runtime remains sqlite. postgres is deliberately blocked until the full
# asynchronous application/financial-guard port passes cutover acceptance.
REPAID_DATABASE_ENGINE=sqlite
# Test/rehearsal URLs only; never point migration tests at a live application DB.
# REPAID_PG_TEST_ADMIN_URL=
# REPAID_PG_REHEARSAL_URL=
# REPAID_PG_CA_FILE=

# Optional private content-addressed attachment storage. Existing BLOBs remain.
# Create a private persistent directory, configure off-host object retention and
# rehearse combined DB/object recovery BEFORE enabling filesystem storage.
REPAID_ATTACHMENT_STORAGE=database
# REPAID_OBJECT_DIR=
REPAID_OBJECT_MIN_FREE_BYTES=5368709120
# Legacy extraction always targets an identified OFFLINE COPY, never the active DB.
# REPAID_ATTACHMENT_MIGRATION_SOURCE=
# REPAID_ATTACHMENT_MIGRATION_OUTPUT=
# REPAID_ATTACHMENT_MIGRATION_REPORT=
# REPAID_ATTACHMENT_MIGRATION_RESUME=0
# REPAID_ATTACHMENT_RETAIN_BLOBS=0
# PostgreSQL core guard port rehearsal; no live application engine switch.
# REPAID_PG_SOURCE_REPORT=
# REPAID_PG_LEDGER_REPORT=

# Separate backup key: generate privately, retain off-host, never commit it.
# REPAID_BACKUP_KEY=
# REPAID_BACKUP_DIR=/var/backups/repaid
# Optional separately mounted private second location; never inferred to be off-host.
# REPAID_BACKUP_COPY_DIR=/mnt/offhost/repaid
REPAID_BACKUP_MAX_AGE_SECONDS=7200
REPAID_BACKUP_MIN_FREE_BYTES=5368709120
# Optional existing private workspace on a disk with room for snapshot + reserve.
# REPAID_BACKUP_WORK_DIR=
# Explicit new destinations for manual backup/restore; existing files are refused.
# REPAID_BACKUP_OUTPUT=
# REPAID_BACKUP_INPUT=
# REPAID_RESTORE_OUTPUT=

# فقط اگر می‌خواهید خروجی standalone برای داکر/سرور بسازید:
# BUILD_STANDALONE=1
